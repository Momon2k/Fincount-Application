# API Configuration
# Production (Railway FastAPI)
API_BASE_URL=https://fincount-api-production.up.railway.app/api

# Development - Local Network
# API_BASE_URL=http://192.168.1.9:3000/api

# Development - Android Emulator (use 10.0.2.2 instead of localhost)
# API_BASE_URL=http://10.0.2.2:3000/api

# Development - iOS Simulator (use localhost)
# API_BASE_URL=http://localhost:3000/api

# Development - Physical Device (replace XXX.XXX.XXX.XXX with your computer's local IP)
# Find your IP: Windows (ipconfig), Mac/Linux (ifconfig)
# API_BASE_URL=http://192.168.1.XXX:3000/api

# Authentication
JWT_SECRET=your-jwt-secret-key

# Database (if using with Next.js)
DATABASE_URL=your-database-connection-string

# Other environment variables
APP_ENV=development
